PORT=3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/do-campo-a-mesa

# Autenticação JWT
JWT_SECRET=colocar-aqui-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=2h

# Origem da aplicação React (CORS e Socket.IO)
CLIENT_URL=http://localhost:5173

# Armazenamento alternativo (Azure Blob Storage)
STORAGE_CONN=
STORAGE_CONTAINER=produtos

# Serviço de mapas / geocodificação
NOMINATIM_USER_AGENT=DoCampoAMesa/1.0 (contacto: exemplo@exemplo.pt)

# Supabase Storage - API S3
SUPABASE_S3_ENDPOINT=https://exemplo.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=eu-west-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_BUCKET=produtos

# Projeto Supabase
SUPABASE_URL=https://exemplo.supabase.co